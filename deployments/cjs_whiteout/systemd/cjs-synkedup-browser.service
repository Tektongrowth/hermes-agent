[Unit]
Description=CJS SynkedUP persistent browser lane
After=network-online.target cjs-synkedup-display.service
Wants=network-online.target
Requires=cjs-synkedup-display.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=cjs-synkedup
Group=cjs-synkedup
Environment=HOME=/var/lib/cjs-synkedup
Environment=DISPLAY=:120
ExecStart=/usr/bin/google-chrome --user-data-dir=/var/lib/cjs-synkedup/chrome --remote-debugging-address=127.0.0.1 --remote-debugging-port=9341 --remote-allow-origins=http://127.0.0.1:9341 --no-first-run --no-default-browser-check --disable-sync --disable-dev-shm-usage --disable-features=TranslateUI --password-store=basic --start-maximized https://app.synkedup.com
ExecStartPost=/opt/cjs-whiteout/bin/wait-for-local-port 9341 60
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cjs-synkedup
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=256
MemoryMax=4G

[Install]
WantedBy=multi-user.target
